{
    "name": "markocupic/swiss-alpine-club-contao-login-client-bundle",
    "description": "Contao SSO Login Client for OIDC Server at Swiss Alpine Club",
    "keywords": [
        "Contao",
        "Swiss Alpine Club SAC",
        "SAC Single Sign On - SSO-Login",
        "OAuth2 Client",
        "SSO"
    ],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Marko Cupic",
            "homepage": "https://github.com/markocupic",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/swiss-alpine-club-contao-login-client-bundle/issues",
        "source": "https://github.com/markocupic/swiss-alpine-club-contao-login-client-bundle"
    },
    "require": {
        "php": "^8.3",
        "codefog/contao-haste": "^5.1",
        "contao/core-bundle": "^5.3",
        "league/oauth2-client": "^2.6",
        "markocupic/contao-twig-assets": "^1.0",
        "markocupic/sac-event-tool-bundle": "*",
        "symfony/asset": "^6.0 || ^7.0",
        "symfony/webpack-encore-bundle": "^v2.0"
    },
    "require-dev": {
        "markocupic/easy-coding-standard": "^13.0",
        "contao/manager-plugin": "^2.3.1",
        "contao/test-case": "^5.3",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.3 || ^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\SwissAlpineClubContaoLoginClientBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markocupic\\SwissAlpineClubContaoLoginClientBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false
        }
    },
    "scripts": {
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check src tests --config tools/ecs/config/default.php --ansi",
        "cs-fixer-fix": "@php tools/ecs/vendor/bin/ecs check src tests --fix --config tools/ecs/config/default.php --ansi",
        "phpstan": "@php tools/phpstan/vendor/bin/phpstan analyse --configuration=tools/phpstan/phpstan.neon.dist --memory-limit=-1 --ansi --level 0",
        "unit-tests": "@php tools/phpunit/vendor/bin/phpunit --configuration=tools/phpunit/phpunit.xml.dist --colors=always"
    },
    "extra": {
        "contao-manager-plugin": "Markocupic\\SwissAlpineClubContaoLoginClientBundle\\ContaoManager\\Plugin"
    }
}
