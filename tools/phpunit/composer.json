{
    "description": "Isolated PHPUnit installation. Keep the version ranges in sync with the require-dev section of the bundle.",
    "require": {
        "phpunit/phpunit": "^9.3 || ^10.0 || ^11.0 || ^12.0",
        "contao/test-case": "^5.3"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
